# Template file for 'obsidian'
pkgname=obsidian
version=1.14.4
revision=1
archs="x86_64 aarch64"
depends="hicolor-icon-theme libsecret xdg-utils"
short_desc="Knowledge base that works on top of local Markdown files"
maintainer="gluow3377 <344402541+gluow3377@users.noreply.github.com>"
license="custom:Proprietary"
homepage="https://obsidian.md"
changelog="https://obsidian.md/changelog/"

case "$XBPS_TARGET_MACHINE" in
	x86_64)
		distfiles="https://github.com/obsidianmd/obsidian-releases/releases/download/v${version}/obsidian-${version}.tar.gz"
		checksum=e70b7cd63787e7f798a84fec453f5c446b91877bd3f612e8fb98e9b76cc81120
		;;
	aarch64)
		distfiles="https://github.com/obsidianmd/obsidian-releases/releases/download/v${version}/obsidian-${version}-arm64.tar.gz"
		checksum=fc212804515713ed85fe5ef5bc4b009872bcc01847c4be4fcc14971deee2a42d
		;;
esac

restricted=yes
repository=nonfree
nostrip=yes
noshlibprovides=yes

do_install() {
	vmkdir usr/lib/obsidian
	vcopy "*" usr/lib/obsidian
	rm ${DESTDIR}/usr/lib/obsidian/LICENSE*

	vbin ${FILESDIR}/obsidian.sh obsidian
	ln -s /usr/lib/obsidian/obsidian-cli ${DESTDIR}/usr/bin/obsidian-cli

	vinstall ${FILESDIR}/md.obsidian.Obsidian.desktop 644 usr/share/applications
	vinstall ${FILESDIR}/obsidian.xml 644 usr/share/mime/packages
	vinstall resources/icon.png 644 usr/share/icons/hicolor/512x512/apps obsidian.png

	vlicense ${FILESDIR}/LICENSE
	vlicense LICENSE.electron.txt
	vlicense LICENSES.chromium.html
}
