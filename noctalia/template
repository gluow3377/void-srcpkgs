# Template file for 'noctalia'
pkgname=noctalia
version=5.3.0
revision=1
build_style=meson
build_helper=qemu
configure_args="--buildtype=release"
make_check_args="--exclude noctalia:notification_reply_integration"
hostmakedepends="pkg-config wayland-devel"
makedepends="cairo-devel fontconfig-devel freetype-devel harfbuzz-devel json-c++
 libcurl-devel libglib-devel libglvnd-devel libical-devel libjxl-devel
 libmd4c-devel libqalculate-devel librsvg-devel libsecret-devel libsndfile-devel
 libsodium-devel libwebp-devel libxkbcommon-devel libxml2-devel pam-devel
 pango-devel pipewire-devel polkit-devel sdbus-c++-devel stb tomlplusplus-devel
 wayland-devel wayland-protocols wireplumber-devel"
depends="git sound-theme-freedesktop"
checkdepends="dbus dejavu-fonts-ttf git openssl"
short_desc="Sleek, customizable desktop shell crafted for Wayland"
maintainer="gluow3377 <344402541+gluow3377@users.noreply.github.com>"
license="MIT AND Apache-2.0"
homepage="https://github.com/noctalia-dev/noctalia"
changelog="https://github.com/noctalia-dev/noctalia/releases"
distfiles="${homepage}/archive/refs/tags/v${version}.tar.gz"
checksum=7677b5d7da80cf89c7a8232de26d25380aa5fcaf34fb38abddd4fe7cb676161a

if [ "$XBPS_TARGET_LIBC" = glibc ]; then
	makedepends+=" jemalloc-devel"
	configure_args+=" -Djemalloc=enabled"
else
	configure_args+=" -Djemalloc=disabled"
fi

if [ "$XBPS_CHECK_PKGS" ]; then
	configure_args+=" -Dtests=enabled"
else
	configure_args+=" -Dtests=disabled"
fi

if [ "${XBPS_TARGET_MACHINE%-musl}" = i686 ]; then
	make_check_args+=" --exclude noctalia:plugin_recommendations
	 --exclude noctalia:plugin_recommendations_http"
fi

post_install() {
	vlicense LICENSE
	vlicense third_party/fzy/LICENSE LICENSE.fzy
	vlicense third_party/luau/LICENSE.txt LICENSE.luau
	vsconf example.toml

	for shell in bash fish zsh; do
		vtargetrun ${DESTDIR}/usr/bin/noctalia completions ${shell} > noctalia.${shell}
		vcompletion noctalia.${shell} ${shell}
	done
}
